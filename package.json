{
  "name": "pi-agent-portrait",
  "version": "0.3.0",
  "description": "Animated pixel-art portrait of your pi agent, with a script that draws a new one for each agent",
  "author": "testy-cool, based on pi-emote by CGx",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testy-cool/pi-agent-portrait.git"
  },
  "homepage": "https://github.com/testy-cool/pi-agent-portrait#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pixel-art",
    "emote",
    "avatar",
    "tui"
  ],
  "files": [
    "src",
    "emotes",
    "scripts",
    "!emotes/test",
    "!emotes/_unused",
    "config.json",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/testy-cool/pi-agent-portrait/main/docs/demo.gif"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
